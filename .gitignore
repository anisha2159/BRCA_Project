# ============================================================
# Git Ignore for BRCA Project
# ============================================================

# --- OS & System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
__MACOSX/
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Large Datasets & Storage (Bioinformatics / Raw & Processed Data) ---
data/
**/data/
raw/
**/raw/
processed/
**/processed/
metadata/
**/metadata/

# --- Heavy Analysis Results & Outputs ---
results/
**/results/
results_backup/
**/results_backup/
reports/
**/reports/

# --- Heavy Data Files & Binary Archives ---
*.gz
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar
*.parcel

# --- Genomic & Expression Data Formats (Large Matrices & Tables) ---
*.tsv
*.csv
*.rds
*.rda
*.RData
*.npz
*.npy
*.h5
*.hdf5
*.parquet
*.feather

# Allow small example/metadata JSON or config if needed
!metadata.repository*.json

# --- Machine Learning Models & Serialized Objects ---
*.joblib
*.pkl
*.pickle
*.model
*.pt
*.pth
*.onnx

# --- GDC Client & Binaries ---
gdc-client
gdc-client.exe
*.exe
*.bin
*.dll
*.so

# --- Python Environment & Caches ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/
ENV/
.pytest_cache/
.coverage
htmlcov/

# --- R Environment & History ---
.Rhistory
.RData
.Ruserdata
.Rproj.user/

# --- Streamlit & Web App Local Caches ---
.streamlit/
*.streamlit

# --- Logs & Command Outputs ---
*.log
run_all_output.txt
*.out

# --- IDEs & Code Editors ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
